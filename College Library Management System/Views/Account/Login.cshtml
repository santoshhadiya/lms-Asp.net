@model College_Library_Management_System.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Library Portal Login";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #1e3a8a, #0284c7) !important;">
                        <div class="mb-2">
                            <i class="bi bi-book-half fs-1"></i>
                        </div>
                        <h3 class="fw-bold mb-1">College Library</h3>
                        <p class="text-white-50 small mb-0">Staff & Student Portal Login</p>
                    </div>

                    <div class="card-body p-4 p-md-4">
                        <form asp-action="Login" method="post" id="loginForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="e.g. your.email@collegelibrary.edu" autocomplete="email" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-0"></label>
                                    <a asp-action="ForgotPassword" class="small text-primary text-decoration-none">Forgot password?</a>
                                </div>
                                <div class="input-group mt-1">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••" autocomplete="current-password" required />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary btn-lg fw-semibold" style="background-color: #1e3a8a; border-color: #1e3a8a;">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </button>
                            </div>
                        </form>

                        <div class="mt-4 pt-3 border-top">
                            <div class="small fw-semibold text-secondary mb-2">Default Demonstration Credentials:</div>
                            <div class="p-2 bg-light rounded border text-muted small">
                                <div><strong>Admin:</strong> <code>admin@collegelibrary.edu</code> / <code>Admin@123456</code></div>
                                <div class="mt-1"><strong>Librarian:</strong> <code>librarian@collegelibrary.edu</code> / <code>Librarian@123456</code></div>
                                <div class="mt-1"><strong>Students:</strong> Registered Email / Temporary Password</div>
                            </div>
                        </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center text-muted small mt-4">
                    College Library Administration &copy; 2026. All transactions logged and audited.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
