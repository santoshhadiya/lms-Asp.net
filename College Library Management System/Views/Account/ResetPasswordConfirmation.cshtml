@{
    ViewData["Title"] = "Password Reset Complete";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden text-center">
                    <div class="card-header bg-success text-white py-4" style="background: linear-gradient(135deg, #059669, #10b981) !important;">
                        <i class="bi bi-shield-check display-3"></i>
                        <h4 class="fw-bold mt-2 mb-0">Password Updated</h4>
                    </div>

                    <div class="card-body p-4">
                        <p class="text-secondary mb-4">
                            Your password has been successfully reset. You can now log into your library portal using your new credentials.
                        </p>

                        <a asp-action="Login" class="btn btn-primary-library w-100 py-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Proceed to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
