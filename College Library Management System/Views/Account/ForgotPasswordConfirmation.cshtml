@{
    ViewData["Title"] = "Password Reset Sent";
    Layout = "_Layout";
    var devResetLink = TempData["DevResetLink"]?.ToString();
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden text-center">
                    <div class="card-header bg-success text-white py-4" style="background: linear-gradient(135deg, #059669, #10b981) !important;">
                        <i class="bi bi-envelope-check-fill fs-1"></i>
                        <h4 class="fw-bold mt-2 mb-0">Check Your Email</h4>
                    </div>

                    <div class="card-body p-4">
                        <p class="text-secondary mb-4">
                            If an active account exists for that email, a secure, time-limited password reset link has been dispatched.
                        </p>

                        @if (!string.IsNullOrEmpty(devResetLink))
                        {
                            <div class="alert alert-info text-start small mb-4">
                                <div class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i> Development Reset Link:</div>
                                <div class="text-muted mb-2">In local development without SMTP, click the link below to test immediately:</div>
                                <a href="@devResetLink" class="btn btn-sm btn-outline-primary text-break w-100">
                                    <i class="bi bi-link-45deg me-1"></i> Open Password Reset Form
                                </a>
                            </div>
                        }

                        <a asp-action="Login" class="btn btn-outline-primary w-100">
                            <i class="bi bi-arrow-left me-1"></i> Return to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
