@model College_Library_Management_System.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #1e3a8a, #0284c7) !important;">
                        <div class="mb-2">
                            <i class="bi bi-key-fill fs-1"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Reset Password</h3>
                        <p class="text-white-50 small mb-0">Enter your email to receive a password recovery link</p>
                    </div>

                    <div class="card-body p-4">
                        <form asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="your.email@collegelibrary.edu" autocomplete="email" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                                <div class="form-text small">We'll generate a time-limited reset link for your account.</div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary btn-lg fw-semibold" style="background-color: #1e3a8a; border-color: #1e3a8a;">
                                    <i class="bi bi-send me-1"></i> Send Reset Link
                                </button>
                            </div>

                            <div class="text-center mt-3">
                                <a asp-action="Login" class="text-decoration-none small text-secondary">
                                    <i class="bi bi-arrow-left me-1"></i> Back to Login
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
