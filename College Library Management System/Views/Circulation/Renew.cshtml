@model College_Library_Management_System.ViewModels.Circulation.RenewLoanViewModel
@{
    ViewData["Title"] = "Renew Book Loan";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card-custom">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-arrow-repeat"></i> Renew Book Loan</span>
                <a asp-action="ActiveLoans" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Active Loans
                </a>
            </div>

            <div class="card-body p-4">
                <div class="p-3 bg-light rounded border mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="font-monospace fw-bold text-primary">@Model.AccessionNumber</span>
                        <span class="badge @(Model.RenewalCount >= Model.MaxRenewals ? "bg-warning text-dark" : "bg-info text-dark")">
                            Renewals: @Model.RenewalCount / @Model.MaxRenewals
                        </span>
                    </div>

                    <h6 class="fw-bold mb-2">@Model.BookTitle</h6>
                    <div class="small text-muted">
                        Borrower: <strong>@Model.StudentName</strong> (@Model.StudentEnrollment)
                    </div>
                </div>

                @if (!Model.IsEligible)
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4">
                        <i class="bi bi-x-octagon-fill fs-3 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Loan Not Eligible for Renewal</h6>
                            <p class="mb-0 small">@Model.IneligibilityReason</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="ActiveLoans" class="btn btn-light border">Back to Loans</a>
                        <a asp-action="Return" asp-route-id="@Model.LoanId" class="btn btn-success">
                            <i class="bi bi-box-arrow-in-down me-1"></i> Proceed to Return
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded border">
                                <span class="text-muted small d-block">Current Due Date</span>
                                <span class="fw-bold fs-6 text-dark">@Model.CurrentDueAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-success-subtle rounded border border-success">
                                <span class="text-success small d-block fw-semibold">New Due Date (+14 days)</span>
                                <span class="fw-bold fs-6 text-success">@Model.NewDueAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info small mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Policy reminder: Each book loan can be renewed at most <strong>1 time</strong> for an additional 14 days, provided the book is not already overdue.
                    </div>

                    <form asp-action="RenewConfirm" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="loanId" value="@Model.LoanId" />

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="ActiveLoans" class="btn btn-light border">Cancel</a>
                            <button type="submit" class="btn btn-primary-library">
                                <i class="bi bi-arrow-repeat me-1"></i> Confirm 14-Day Renewal
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
