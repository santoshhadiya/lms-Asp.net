@using College_Library_Management_System.Models.Enums
@using College_Library_Management_System.ViewModels.Circulation
@model College_Library_Management_System.ViewModels.Common.PaginatedList<LoanHistoryItemViewModel>
@{
    ViewData["Title"] = "Issue & Return History";
    var filter = (LoanHistoryFilterViewModel)ViewBag.Filter;
    var currentTab = (filter.ActiveTab ?? "all").ToLowerInvariant();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">
            <i class="bi bi-clock-history me-1"></i> Issue & Return History
        </h2>
        <p class="text-muted small mb-0">Complete circulation audit trail of all issued books and return records across all departments.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportHistory"
           asp-route-searchTerm="@filter.SearchTerm"
           asp-route-departmentId="@filter.DepartmentId"
           asp-route-status="@filter.Status"
           asp-route-activeTab="@filter.ActiveTab"
           asp-route-fromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
           asp-route-toDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
           asp-route-dateFilterType="@filter.DateFilterType"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary d-none d-md-inline-block">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <a asp-action="Issue" class="btn btn-primary-library">
            <i class="bi bi-box-arrow-up-right me-1"></i> Issue Book
        </a>
        <a asp-action="Return" class="btn btn-outline-primary">
            <i class="bi bi-box-arrow-in-down me-1"></i> Return Book
        </a>
    </div>
</div>

<!-- Summary Metric KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 h-100 border-primary-subtle">
            <div class="d-flex align-items-center">
                <div class="p-3 rounded bg-primary-subtle text-primary me-3">
                    <i class="bi bi-journal-album fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Loans Logged</div>
                    <div class="fs-4 fw-bold text-dark">@filter.Summary.TotalLoans</div>
                    <div class="small text-muted">All-time circulation transactions</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 h-100 border-info-subtle">
            <div class="d-flex align-items-center">
                <div class="p-3 rounded bg-info-subtle text-info-emphasis me-3">
                    <i class="bi bi-box-arrow-up-right fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Currently Issued</div>
                    <div class="fs-4 fw-bold text-primary">@filter.Summary.ActiveLoansCount</div>
                    <div class="small text-muted">Active loans with students</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 h-100 border-success-subtle">
            <div class="d-flex align-items-center">
                <div class="p-3 rounded bg-success-subtle text-success me-3">
                    <i class="bi bi-box-arrow-in-down fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Returned Books</div>
                    <div class="fs-4 fw-bold text-success">@filter.Summary.ReturnedLoansCount</div>
                    <div class="small text-muted">Safely checked back in</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 h-100 border-danger-subtle">
            <div class="d-flex align-items-center">
                <div class="p-3 rounded bg-danger-subtle text-danger me-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Overdue / Lost</div>
                    <div class="fs-4 fw-bold text-danger">@(filter.Summary.OverdueLoansCount + filter.Summary.LostLoansCount)</div>
                    <div class="small text-muted">
                        @filter.Summary.OverdueLoansCount active overdue | ₹@filter.Summary.TotalFinesAssessed.ToString("N0") fines
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section Switcher Tabs -->
<div class="card-custom mb-3">
    <div class="card-body p-2 d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <div class="nav nav-pills" role="tablist">
            <a class="nav-link @(currentTab == "all" ? "active" : "")"
               asp-action="History"
               asp-route-activeTab="all"
               asp-route-searchTerm="@filter.SearchTerm"
               asp-route-departmentId="@filter.DepartmentId"
               asp-route-fromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-toDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-dateFilterType="@filter.DateFilterType"
               asp-route-pageSize="@filter.PageSize">
                <i class="bi bi-collection me-1"></i> All Circulation Records
                <span class="badge @(currentTab == "all" ? "bg-light text-dark" : "bg-secondary") ms-1">@filter.Summary.TotalLoans</span>
            </a>

            <a class="nav-link @(currentTab == "issued" ? "active" : "")"
               asp-action="History"
               asp-route-activeTab="issued"
               asp-route-searchTerm="@filter.SearchTerm"
               asp-route-departmentId="@filter.DepartmentId"
               asp-route-fromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-toDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-dateFilterType="Issued"
               asp-route-pageSize="@filter.PageSize">
                <i class="bi bi-box-arrow-up-right me-1"></i> Issued Books History
                <span class="badge @(currentTab == "issued" ? "bg-light text-dark" : "bg-primary") ms-1">@filter.Summary.ActiveLoansCount active</span>
            </a>

            <a class="nav-link @(currentTab == "returned" ? "active" : "")"
               asp-action="History"
               asp-route-activeTab="returned"
               asp-route-searchTerm="@filter.SearchTerm"
               asp-route-departmentId="@filter.DepartmentId"
               asp-route-fromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-toDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-dateFilterType="Returned"
               asp-route-pageSize="@filter.PageSize">
                <i class="bi bi-box-arrow-in-down me-1"></i> Returned Books History
                <span class="badge @(currentTab == "returned" ? "bg-light text-dark" : "bg-success") ms-1">@filter.Summary.ReturnedLoansCount returned</span>
            </a>
        </div>

        <div class="text-muted small px-3">
            Showing <strong>@Model.Count</strong> of <strong>@Model.TotalCount</strong> records
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="History" class="row g-2 align-items-end">
            <input type="hidden" name="ActiveTab" value="@filter.ActiveTab" />

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Search Records</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Student, Enrollment, Accession, Title, Staff..." value="@filter.SearchTerm" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Department</label>
                <select name="DepartmentId" class="form-select form-select-sm" asp-items="filter.DepartmentOptions">
                    <option value="">-- All Departments --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">-- All Statuses --</option>
                    <!option value="0" @(filter.Status == LoanStatus.Active ? "selected" : "")>Active (Issued)</!option>
                    <!option value="1" @(filter.Status == LoanStatus.Returned ? "selected" : "")>Returned</!option>
                    <!option value="2" @(filter.Status == LoanStatus.Lost ? "selected" : "")>Reported Lost</!option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Date Range</label>
                <div class="input-group input-group-sm">
                    <select name="DateFilterType" class="form-select form-select-sm" style="max-width: 95px;">
                        <!option value="Issued" @(filter.DateFilterType == "Issued" ? "selected" : "")>Issued</!option>
                        <!option value="Returned" @(filter.DateFilterType == "Returned" ? "selected" : "")>Returned</!option>
                    </select>
                    <input type="date" name="FromDate" class="form-control" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" title="From Date" />
                    <input type="date" name="ToDate" class="form-control" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" title="To Date" />
                </div>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary-library flex-grow-1">
                    <i class="bi bi-funnel"></i> Apply
                </button>
                <a asp-action="History" asp-route-activeTab="@filter.ActiveTab" class="btn btn-sm btn-light border" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Records Table Card -->
<div class="card-custom">
    <div class="card-header">
        <span class="card-title">
            @if (currentTab == "issued")
            {
                <i class="bi bi-box-arrow-up-right text-primary me-1"></i>
                <span>Issued Books History Log</span>
            }
            else if (currentTab == "returned")
            {
                <i class="bi bi-box-arrow-in-down text-success me-1"></i>
                <span>Returned Books History Log</span>
            }
            else
            {
                <i class="bi bi-clock-history text-secondary me-1"></i>
                <span>All Circulation History Logs</span>
            }
        </span>
        <span class="badge bg-secondary">Total: @Model.TotalCount items</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Accession / Book Title</th>
                    <th>Borrower Student</th>
                    <th>Dept</th>
                    <th>Issued Details</th>
                    <th>Due Date</th>
                    <th>Returned Details</th>
                    <th>Status</th>
                    <th>Condition / Notes</th>
                    <th>Fine / Fees</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-2 text-secondary"></i>
                            <div>No circulation records found matching the specified criteria.</div>
                            <a asp-action="History" asp-route-activeTab="@filter.ActiveTab" class="btn btn-sm btn-outline-primary mt-2">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                            </a>
                        </td>
                    </tr>
                }
                @foreach (var loan in Model)
                {
                    <tr class="@(loan.IsOverdue ? "table-danger-subtle border-start border-danger border-4" : loan.Status == LoanStatus.Returned ? "table-light-subtle" : "")">
                        <!-- Book & Accession -->
                        <td>
                            <a asp-controller="BookCopies" asp-action="History" asp-route-id="@loan.BookCopyId" class="font-monospace fw-bold text-primary text-decoration-none">
                                @loan.AccessionNumber
                            </a>
                            <div class="small fw-semibold text-dark text-truncate" style="max-width: 220px;" title="@loan.BookTitle">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@loan.BookId" class="text-decoration-none text-dark">
                                    @loan.BookTitle
                                </a>
                            </div>
                            @if (!string.IsNullOrEmpty(loan.ShelfLocation))
                            {
                                <div class="text-muted" style="font-size: 0.72rem;">
                                    <i class="bi bi-geo-alt"></i> @loan.ShelfLocation
                                </div>
                            }
                        </td>

                        <!-- Student Borrower -->
                        <td>
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@loan.StudentId" class="text-decoration-none fw-semibold text-dark d-block">
                                @loan.StudentName
                            </a>
                            <span class="font-monospace small text-muted">@loan.StudentEnrollment</span>
                        </td>

                        <!-- Department -->
                        <td>
                            <span class="badge bg-light text-dark border" title="@loan.DepartmentName">@loan.DepartmentCode</span>
                        </td>

                        <!-- Issue Details -->
                        <td>
                            <div class="small fw-semibold text-dark">@loan.IssuedAt.ToString("dd MMM yyyy")</div>
                            <div class="text-muted font-monospace" style="font-size: 0.72rem;">@loan.IssuedAt.ToString("hh:mm tt")</div>
                            <div class="text-muted small" style="font-size: 0.75rem;">
                                <i class="bi bi-person text-secondary"></i> @loan.IssuedBy
                            </div>
                        </td>

                        <!-- Due Date -->
                        <td>
                            <div class="small fw-semibold @(loan.IsOverdue ? "text-danger" : "text-dark")">
                                @loan.DueAt.ToString("dd MMM yyyy")
                            </div>
                            @if (loan.RenewalCount > 0)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border small" style="font-size: 0.68rem;">
                                    Renewed (@loan.RenewalCount)
                                </span>
                            }
                        </td>

                        <!-- Returned Details -->
                        <td>
                            @if (loan.ReturnedAt.HasValue)
                            {
                                <div class="small fw-semibold text-success">
                                    <i class="bi bi-check2-circle me-1"></i> @loan.ReturnedAt.Value.ToString("dd MMM yyyy")
                                </div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">@loan.ReturnedAt.Value.ToString("hh:mm tt")</div>
                                @if (!string.IsNullOrEmpty(loan.ReceivedBy))
                                {
                                    <div class="text-muted small" style="font-size: 0.75rem;">
                                        <i class="bi bi-person-check text-success"></i> @loan.ReceivedBy
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                    <i class="bi bi-clock me-1"></i> With Borrower
                                </span>
                            }
                        </td>

                        <!-- Status Badge -->
                        <td>
                            @switch (loan.Status)
                            {
                                case LoanStatus.Active:
                                    if (loan.IsOverdue)
                                    {
                                        <span class="badge-status badge-overdue">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Overdue (@loan.OverdueDays d)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-issued">
                                            <i class="bi bi-book"></i> Active Loan
                                        </span>
                                    }
                                    break;
                                case LoanStatus.Returned:
                                    <span class="badge-status badge-returned">
                                        <i class="bi bi-check2"></i> Returned
                                    </span>
                                    break;
                                case LoanStatus.Lost:
                                    <span class="badge-status badge-lost">
                                        <i class="bi bi-x-circle"></i> Lost
                                    </span>
                                    break;
                            }
                        </td>

                        <!-- Return Condition & Notes -->
                        <td>
                            @if (loan.Status == LoanStatus.Returned && loan.ReturnCondition.HasValue)
                            {
                                <span class="badge @(loan.ReturnCondition == BookCopyStatus.Available ? "bg-success-subtle text-success border border-success-subtle" : loan.ReturnCondition == BookCopyStatus.Damaged ? "bg-warning-subtle text-warning-emphasis border" : "bg-danger-subtle text-danger border") small" style="font-size: 0.72rem;">
                                    @loan.ReturnCondition
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(loan.ConditionNotes))
                            {
                                <div class="text-muted small text-truncate" style="max-width: 140px; font-size: 0.72rem;" title="@loan.ConditionNotes">
                                    <i class="bi bi-chat-left-text me-1"></i>@loan.ConditionNotes
                                </div>
                            }
                            else if (loan.Status == LoanStatus.Active)
                            {
                                <span class="text-muted small" style="font-size: 0.72rem;">-</span>
                            }
                        </td>

                        <!-- Fine / Penalty -->
                        <td>
                            @if (loan.EstimatedOrActualFine > 0)
                            {
                                <div class="fw-bold @(loan.FineStatus == FineStatus.Paid ? "text-success" : "text-danger")">
                                    ₹@loan.EstimatedOrActualFine.ToString("N2")
                                </div>
                                @if (loan.FineStatus.HasValue)
                                {
                                    <span class="badge-status @(loan.FineStatus == FineStatus.Paid ? "badge-paid" : loan.FineStatus == FineStatus.Waived ? "badge-waived" : "badge-pending")" style="font-size: 0.68rem;">
                                        @loan.FineStatus
                                    </span>
                                }
                                else if (loan.IsOverdue)
                                {
                                    <span class="badge bg-danger small font-monospace" style="font-size: 0.65rem;">Late Fee Est.</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">₹0.00</span>
                            }
                        </td>

                        <!-- Actions -->
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (loan.Status == LoanStatus.Active)
                                {
                                    <a asp-action="Return" asp-route-id="@loan.LoanId" class="btn btn-outline-success btn-sm" title="Quick Return">
                                        <i class="bi bi-box-arrow-in-down"></i> Return
                                    </a>
                                }
                                <a asp-controller="BookCopies" asp-action="History" asp-route-id="@loan.BookCopyId" class="btn btn-light border btn-sm" title="Physical Copy Audit History">
                                    <i class="bi bi-clock-history"></i>
                                </a>
                                <a asp-controller="Students" asp-action="Details" asp-route-id="@loan.StudentId" class="btn btn-light border btn-sm" title="Student Profile & Loans">
                                    <i class="bi bi-person"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
            <span class="small text-muted">
                Showing page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount total circulation records)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="History"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-activeTab="@filter.ActiveTab"
                       asp-route-searchTerm="@filter.SearchTerm"
                       asp-route-departmentId="@filter.DepartmentId"
                       asp-route-status="@filter.Status"
                       asp-route-fromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                       asp-route-toDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                       asp-route-dateFilterType="@filter.DateFilterType"
                       asp-route-pageSize="@filter.PageSize">Previous</a>
                </li>
                @for (int p = Math.Max(1, Model.PageIndex - 3); p <= Math.Min(Model.TotalPages, Model.PageIndex + 3); p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="History"
                           asp-route-pageNumber="@p"
                           asp-route-activeTab="@filter.ActiveTab"
                           asp-route-searchTerm="@filter.SearchTerm"
                           asp-route-departmentId="@filter.DepartmentId"
                           asp-route-status="@filter.Status"
                           asp-route-fromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                           asp-route-toDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                           asp-route-dateFilterType="@filter.DateFilterType"
                           asp-route-pageSize="@filter.PageSize">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="History"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-activeTab="@filter.ActiveTab"
                       asp-route-searchTerm="@filter.SearchTerm"
                       asp-route-departmentId="@filter.DepartmentId"
                       asp-route-status="@filter.Status"
                       asp-route-fromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                       asp-route-toDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                       asp-route-dateFilterType="@filter.DateFilterType"
                       asp-route-pageSize="@filter.PageSize">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
