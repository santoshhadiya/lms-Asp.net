@model IEnumerable<College_Library_Management_System.ViewModels.MasterData.AuthorViewModel>
@{
    ViewData["Title"] = "Authors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Book Authors</h2>
        <p class="text-muted small mb-0">Writers, researchers, and contributing scholars.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-library">
        <i class="bi bi-person-plus me-1"></i> Add Author
    </a>
</div>

<div class="card-custom">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-pen-fill"></i> Registered Authors</span>
        <span class="badge bg-secondary">Total: @Model.Count()</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Author Name</th>
                    <th>Biography / Notes</th>
                    <th>Linked Books</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No authors registered yet.</td>
                    </tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-bold">@a.Name</td>
                        <td class="text-muted small">@(a.Biography ?? "N/A")</td>
                        <td>
                            <span class="badge rounded-pill @(a.BookCount > 0 ? "bg-info text-dark" : "bg-light text-muted border")">
                                <i class="bi bi-book me-1"></i>@a.BookCount Books
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@a.AuthorId" class="btn btn-outline-primary btn-sm-action me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                @if (a.BookCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@a.AuthorId" method="post" class="d-inline" onsubmit="return confirm('Delete author \'@a.Name\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm-action">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm-action disabled" disabled title="Cannot delete author linked to cataloged books">
                                        <i class="bi bi-lock"></i> Protected
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
