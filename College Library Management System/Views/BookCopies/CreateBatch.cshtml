@model College_Library_Management_System.ViewModels.Inventory.BatchCopyFormViewModel
@{
    ViewData["Title"] = "Batch Add Physical Copies";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card-custom">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-collection"></i> Batch Add Book Copies</span>
                <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Book
                </a>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-primary d-flex align-items-center mb-4">
                    <i class="bi bi-book fs-4 me-3"></i>
                    <div>
                        <div class="small text-uppercase fw-bold text-muted">Target Book</div>
                        <h6 class="fw-bold mb-0">@Model.BookTitle</h6>
                    </div>
                </div>

                <div class="alert alert-secondary small mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Batch generation creates sequential accession numbers automatically (e.g. with prefix <strong>ACC-</strong> and starting number <strong>1</strong> for <strong>5</strong> copies, copies <strong>ACC-0001</strong> through <strong>ACC-0005</strong> will be created).
                </div>

                <form asp-action="CreateBatch" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BookId" />
                    <input type="hidden" asp-for="BookTitle" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Prefix" class="form-label fw-semibold"></label>
                            <input asp-for="Prefix" class="form-control font-monospace" placeholder="e.g. ACC-, CS-, IT-" maxlength="20" required id="prefixInput" />
                            <span asp-validation-for="Prefix" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="StartingNumber" class="form-label fw-semibold"></label>
                            <input asp-for="StartingNumber" class="form-control font-monospace" type="number" min="1" max="999999" required id="startNumInput" />
                            <span asp-validation-for="StartingNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="NumberOfCopies" class="form-label fw-semibold"></label>
                            <input asp-for="NumberOfCopies" class="form-control font-monospace" type="number" min="1" max="100" required id="copiesCountInput" />
                            <span asp-validation-for="NumberOfCopies" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded border">
                                <span class="fw-semibold small text-muted d-block mb-1">Generated Range Preview:</span>
                                <span id="previewRange" class="font-monospace fw-bold text-primary">ACC-0001 &rarr; ACC-0005 (5 copies)</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="ShelfLocation" class="form-label fw-semibold"></label>
                            <input asp-for="ShelfLocation" class="form-control" placeholder="e.g. Main Stack Row 3, Rack A" maxlength="50" required />
                            <span asp-validation-for="ShelfLocation" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ConditionNotes" class="form-label fw-semibold"></label>
                            <input asp-for="ConditionNotes" class="form-control" placeholder="e.g. New Copies - Mint Condition" maxlength="500" />
                            <span asp-validation-for="ConditionNotes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary-library">
                            <i class="bi bi-plus-square me-1"></i> Generate & Add Copies
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updatePreview() {
            const prefix = document.getElementById('prefixInput').value || '';
            const startNum = parseInt(document.getElementById('startNumInput').value) || 1;
            const count = parseInt(document.getElementById('copiesCountInput').value) || 1;
            const padLen = Math.max(4, String(startNum + count - 1).length);
            
            const startStr = prefix + String(startNum).padStart(padLen, '0');
            const endNum = startNum + count - 1;
            const endStr = prefix + String(endNum).padStart(padLen, '0');
            
            document.getElementById('previewRange').textContent = `${startStr} → ${endStr} (${count} copies)`;
        }

        document.getElementById('prefixInput').addEventListener('input', updatePreview);
        document.getElementById('startNumInput').addEventListener('input', updatePreview);
        document.getElementById('copiesCountInput').addEventListener('input', updatePreview);
        updatePreview();
    </script>
}
