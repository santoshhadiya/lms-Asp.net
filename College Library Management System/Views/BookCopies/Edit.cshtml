@using College_Library_Management_System.Models.Enums
@model College_Library_Management_System.ViewModels.Inventory.BookCopyFormViewModel
@{
    ViewData["Title"] = "Edit Book Copy - " + Model.AccessionNumber;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card-custom">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-pencil-square"></i> Edit Book Copy</span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Inventory
                </a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BookCopyId" />
                    <input type="hidden" asp-for="BookId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="alert alert-light border d-flex align-items-center mb-3">
                        <i class="bi bi-book me-2 fs-5 text-primary"></i>
                        <div>
                            <div class="small text-muted text-uppercase fw-semibold">Book Title</div>
                            <span class="fw-bold">@Model.BookTitle</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="AccessionNumber" class="form-label fw-semibold"></label>
                            <input asp-for="AccessionNumber" class="form-control font-monospace" maxlength="50" required />
                            <span asp-validation-for="AccessionNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ShelfLocation" class="form-label fw-semibold"></label>
                            <input asp-for="ShelfLocation" class="form-control" maxlength="50" required />
                            <span asp-validation-for="ShelfLocation" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BookCopyStatus>()" required>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                            <div class="form-text">Note: Copies currently issued to students cannot be manually changed to Available here.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="ConditionNotes" class="form-label fw-semibold"></label>
                            <textarea asp-for="ConditionNotes" class="form-control" rows="3" maxlength="500"></textarea>
                            <span asp-validation-for="ConditionNotes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary-library">
                            <i class="bi bi-check2-circle me-1"></i> Update Copy
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
