@using College_Library_Management_System.Models.Enums
@model College_Library_Management_System.ViewModels.Inventory.BookCopyFormViewModel
@{
    ViewData["Title"] = "Add Physical Book Copy";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card-custom">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-box-seam"></i> Add Individual Book Copy</span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Inventory
                </a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    @if (Model.BookId > 0 && !string.IsNullOrEmpty(Model.BookTitle))
                    {
                        <input type="hidden" asp-for="BookId" />
                        <div class="alert alert-info d-flex align-items-center mb-3">
                            <i class="bi bi-book me-2 fs-5"></i>
                            <div>
                                <span class="fw-semibold">Book:</span> @Model.BookTitle
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="BookId" class="form-label fw-semibold"></label>
                            <select asp-for="BookId" class="form-select" asp-items="Model.BookOptions" required>
                                <option value="">-- Select Catalog Book --</option>
                            </select>
                            <span asp-validation-for="BookId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="AccessionNumber" class="form-label fw-semibold"></label>
                            <input asp-for="AccessionNumber" class="form-control font-monospace" placeholder="e.g. ACC-00101" maxlength="50" required />
                            <span asp-validation-for="AccessionNumber" class="text-danger small"></span>
                            <div class="form-text">Must be unique across the entire library system.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ShelfLocation" class="form-label fw-semibold"></label>
                            <input asp-for="ShelfLocation" class="form-control" placeholder="e.g. Rack B, Shelf 3" maxlength="50" required />
                            <span asp-validation-for="ShelfLocation" class="text-danger small"></span>
                            <div class="form-text">Physical location in the library stacks.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BookCopyStatus>()" required>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ConditionNotes" class="form-label fw-semibold"></label>
                            <textarea asp-for="ConditionNotes" class="form-control" rows="3" placeholder="Condition details (e.g. Good condition, pristine hardcover, slight pencil marks on p. 12)" maxlength="500"></textarea>
                            <span asp-validation-for="ConditionNotes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary-library">
                            <i class="bi bi-save me-1"></i> Register Copy
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
