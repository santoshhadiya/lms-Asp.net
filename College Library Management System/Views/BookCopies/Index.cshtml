@using College_Library_Management_System.ViewModels.Inventory
@using College_Library_Management_System.Models.Enums
@model College_Library_Management_System.ViewModels.Common.PaginatedList<BookCopyListItemViewModel>
@{
    ViewData["Title"] = "Physical Book Copies Inventory";
    var filter = (BookCopyListFilterViewModel)ViewBag.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Physical Copies Inventory</h2>
        <p class="text-muted small mb-0">Track shelf locations, accession numbers, physical conditions, and availability status.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary-library">
            <i class="bi bi-plus-circle me-1"></i> Add Individual Copy
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Search Copies</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Accession No, Title, Shelf..." value="@filter.SearchTerm" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Book Title</label>
                <select name="BookId" class="form-select" asp-items="filter.BookOptions">
                    <option value="">-- All Catalog Books --</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="Status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var val in Enum.GetValues<BookCopyStatus>())
                    {
                        <option value="@val" selected="@(filter.Status == val ? "selected" : null)">@val</option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary-library flex-grow-1">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-light border" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Copies Table -->
<div class="card-custom">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-boxes"></i> Physical Inventory</span>
        <span class="badge bg-secondary">Total: @Model.TotalCount copies</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Accession No.</th>
                    <th>Book Title</th>
                    <th>Shelf Location</th>
                    <th>Status</th>
                    <th>Borrower / Due Date</th>
                    <th>Condition Notes</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-3 d-block mb-2"></i>
                            No copies found matching the selected search criteria.
                        </td>
                    </tr>
                }
                @foreach (var copy in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="History" asp-route-id="@copy.BookCopyId" class="font-monospace fw-bold text-primary text-decoration-none">
                                @copy.AccessionNumber
                            </a>
                        </td>
                        <td>
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@copy.BookId" class="fw-semibold text-dark text-decoration-none">
                                @copy.BookTitle
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-geo-alt me-1"></i>@copy.ShelfLocation
                            </span>
                        </td>
                        <td>
                            @{
                                var badgeClass = copy.Status switch
                                {
                                    BookCopyStatus.Available => "badge-available",
                                    BookCopyStatus.Issued => "badge-issued",
                                    BookCopyStatus.Damaged => "badge-damaged",
                                    BookCopyStatus.Lost => "badge-lost",
                                    _ => "badge-withdrawn"
                                };
                            }
                            <span class="badge-status @badgeClass">
                                @copy.Status
                            </span>
                        </td>
                        <td class="small">
                            @if (copy.HasActiveLoan && !string.IsNullOrEmpty(copy.CurrentBorrowerName))
                            {
                                <div class="fw-semibold text-primary">@copy.CurrentBorrowerName</div>
                                @if (copy.DueDate.HasValue)
                                {
                                    <div class="text-muted" style="font-size: 0.75rem;">Due: @copy.DueDate.Value.ToString("dd MMM yyyy")</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="small text-muted">
                            @(string.IsNullOrEmpty(copy.ConditionNotes) ? "Good" : copy.ConditionNotes)
                        </td>
                        <td class="text-end">
                            <a asp-action="History" asp-route-id="@copy.BookCopyId" class="btn btn-outline-info btn-sm-action me-1" title="Loan History">
                                <i class="bi bi-clock-history"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@copy.BookCopyId" class="btn btn-outline-primary btn-sm-action me-1" title="Edit Copy Details">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="ChangeStatus" asp-route-id="@copy.BookCopyId" class="btn btn-outline-secondary btn-sm-action" title="Update Status & Condition">
                                <i class="bi bi-flag"></i> Status
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <div class="small text-muted">
                Showing page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount total copies)
            </div>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-PageNumber="@(Model.PageIndex - 1)"
                       asp-route-SearchTerm="@filter.SearchTerm"
                       asp-route-BookId="@filter.BookId"
                       asp-route-Status="@filter.Status"
                       asp-route-ShelfLocation="@filter.ShelfLocation">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-PageNumber="@i"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-BookId="@filter.BookId"
                           asp-route-Status="@filter.Status"
                           asp-route-ShelfLocation="@filter.ShelfLocation">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-PageNumber="@(Model.PageIndex + 1)"
                       asp-route-SearchTerm="@filter.SearchTerm"
                       asp-route-BookId="@filter.BookId"
                       asp-route-Status="@filter.Status"
                       asp-route-ShelfLocation="@filter.ShelfLocation">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
