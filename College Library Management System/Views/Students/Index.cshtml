@using College_Library_Management_System.ViewModels.Students
@model College_Library_Management_System.ViewModels.Common.PaginatedList<StudentListItemViewModel>
@{
    ViewData["Title"] = "Student Registry";
    var filter = (StudentListFilterViewModel)ViewBag.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Student Registry</h2>
        <p class="text-muted small mb-0">Registered college students, academic standing, and borrowing summaries.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-library">
        <i class="bi bi-person-plus-fill me-1"></i> Register Student
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Search Student</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Enrollment No., Name, Phone..." value="@filter.SearchTerm" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Department</label>
                <select name="DepartmentId" class="form-select" asp-items="filter.DepartmentOptions">
                    <option value="">-- All Departments --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="IsActive" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(filter.IsActive == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(filter.IsActive == false ? "selected" : null)">Inactive</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-library flex-grow-1">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-light border" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Students Table -->
<div class="card-custom">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-people-fill"></i> Students List</span>
        <span class="badge bg-secondary">Total: @Model.TotalCount</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Enrollment No.</th>
                    <th>Student Name</th>
                    <th>Department</th>
                    <th>Semester</th>
                    <th>Status</th>
                    <th>Active Loans</th>
                    <th>Outstanding Fine</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-3 d-block mb-2"></i>
                            No students found matching the selected criteria.
                        </td>
                    </tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@s.StudentId" class="fw-bold text-primary font-monospace text-decoration-none">
                                @s.EnrollmentNumber
                            </a>
                        </td>
                        <td>
                            <div class="fw-semibold">@s.FullName</div>
                            @if (!string.IsNullOrEmpty(s.Email))
                            {
                                <div class="text-muted small">@s.Email</div>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@s.DepartmentCode</span>
                            <span class="small d-none d-lg-inline text-muted">@s.DepartmentName</span>
                        </td>
                        <td>Sem @s.Semester</td>
                        <td>
                            <span class="badge-status @(s.IsActive ? "badge-active" : "badge-withdrawn")">
                                <i class="bi @(s.IsActive ? "bi-check-circle" : "bi-dash-circle")"></i>
                                @(s.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <span class="badge rounded-pill @(s.ActiveLoansCount >= 3 ? "bg-warning text-dark font-weight-bold" : (s.ActiveLoansCount > 0 ? "bg-primary" : "bg-light text-muted border"))">
                                @s.ActiveLoansCount / 3 Books
                            </span>
                        </td>
                        <td>
                            @if (s.OutstandingFinesTotal > 0)
                            {
                                <span class="badge-status badge-pending fw-bold">
                                    ₹@s.OutstandingFinesTotal.ToString("N2")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">₹0.00</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@s.StudentId" class="btn btn-outline-info btn-sm-action me-1" title="View Borrowing Profile">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-outline-primary btn-sm-action" title="Edit Student">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <div class="small text-muted">
                Showing page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount total records)
            </div>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-PageNumber="@(Model.PageIndex - 1)"
                       asp-route-SearchTerm="@filter.SearchTerm"
                       asp-route-DepartmentId="@filter.DepartmentId"
                       asp-route-IsActive="@filter.IsActive">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-PageNumber="@i"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-DepartmentId="@filter.DepartmentId"
                           asp-route-IsActive="@filter.IsActive">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-PageNumber="@(Model.PageIndex + 1)"
                       asp-route-SearchTerm="@filter.SearchTerm"
                       asp-route-DepartmentId="@filter.DepartmentId"
                       asp-route-IsActive="@filter.IsActive">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
