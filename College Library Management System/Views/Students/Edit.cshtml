@model College_Library_Management_System.ViewModels.Students.StudentFormViewModel
@{
    ViewData["Title"] = "Edit Student Profile";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card-custom">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-pencil-square"></i> Edit Student Profile</span>
                <a asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Profile
                </a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="StudentId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EnrollmentNumber" class="form-label fw-semibold"></label>
                            <input asp-for="EnrollmentNumber" class="form-control text-uppercase" maxlength="50" required />
                            <span asp-validation-for="EnrollmentNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" maxlength="150" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold"></label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="Model.DepartmentOptions" required></select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Semester" class="form-label fw-semibold"></label>
                            <select asp-for="Semester" class="form-select" required>
                                @for (int i = 1; i <= 8; i++)
                                {
                                    <option value="@i" selected="@(Model.Semester == i ? "selected" : null)">Semester @i</option>
                                }
                            </select>
                            <span asp-validation-for="Semester" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" maxlength="150" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" maxlength="20" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">Student Account Active for Library Services</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary-library">
                            <i class="bi bi-check-lg me-1"></i> Update Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
