@model College_Library_Management_System.ViewModels.Students.StudentFormViewModel
@{
    ViewData["Title"] = "Register Student";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card-custom">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-person-plus-fill"></i> Register New Student</span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EnrollmentNumber" class="form-label fw-semibold"></label>
                            <input asp-for="EnrollmentNumber" class="form-control text-uppercase" placeholder="e.g. EN2026CS101" maxlength="50" required />
                            <span asp-validation-for="EnrollmentNumber" class="text-danger small"></span>
                            <div class="form-text">Unique college enrollment identifier.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Aarav Sharma" maxlength="150" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold"></label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="Model.DepartmentOptions" required>
                                <option value="">-- Select Department --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Semester" class="form-label fw-semibold"></label>
                            <select asp-for="Semester" class="form-select" required>
                                @for (int i = 1; i <= 8; i++)
                                {
                                    <option value="@i">Semester @i</option>
                                }
                            </select>
                            <span asp-validation-for="Semester" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="aarav.s@college.edu" maxlength="150" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="+91 9876543210" maxlength="20" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TemporaryPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="TemporaryPassword" id="tempPasswordInput" class="form-control" placeholder="Leave empty to auto-generate" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" onclick="generateStudentPassword()">
                                    <i class="bi bi-magic me-1"></i> Auto
                                </button>
                            </div>
                            <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
                            <div class="form-text">Optional. If blank, a secure temporary password is automatically assigned.</div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">Student Account Active for Library Services & Dashboard Login</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary-library">
                            <i class="bi bi-save me-1"></i> Register Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function generateStudentPassword() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$%';
            let pwd = 'Std@@';
            for (let i = 0; i < 6; i++) {
                pwd += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            pwd += '1';
            document.getElementById('tempPasswordInput').value = pwd;
        }
    </script>
}
