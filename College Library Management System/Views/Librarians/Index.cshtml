@model List<College_Library_Management_System.ViewModels.Librarians.LibrarianListItemViewModel>
@{
    ViewData["Title"] = "Librarian Management";
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    var isActive = ViewData["IsActive"] as bool?;
    var generatedPassword = TempData["GeneratedPassword"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">
            <i class="bi bi-people-fill me-1"></i> Librarian Management
        </h2>
        <div class="text-muted small">Manage library staff accounts, status, and credentials (Admin exclusive).</div>
    </div>
    <a asp-action="Create" class="btn btn-primary-library">
        <i class="bi bi-person-plus-fill me-1"></i> Register New Librarian
    </a>
</div>

@if (!string.IsNullOrEmpty(generatedPassword))
{
    <div class="alert alert-warning alert-custom alert-dismissible fade show mb-4 border-warning shadow-sm" role="alert">
        <i class="bi bi-key-fill fs-4 text-warning"></i>
        <div class="flex-grow-1">
            <div class="fw-bold fs-6">Temporary Password Generated</div>
            <div>Please securely provide these login credentials to the staff member:</div>
            <div class="mt-2 p-2 bg-white rounded border d-flex align-items-center justify-content-between">
                <div>
                    <strong>Temporary Password:</strong> <code class="fs-6 text-danger fw-bold ms-1" id="tempPwdText">@generatedPassword</code>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText('@generatedPassword'); this.innerHTML = '<i class=\'bi bi-check\'></i> Copied!';">
                    <i class="bi bi-clipboard me-1"></i> Copy Password
                </button>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Bar -->
<div class="card-custom mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0" placeholder="Search by name, email, or phone..." />
                </div>
            </div>
            <div class="col-md-4 col-lg-3">
                <select name="isActive" class="form-select">
                    <option value="">All Account Statuses</option>
                    <option value="true" selected="@(isActive == true)">Active Only</option>
                    <option value="false" selected="@(isActive == false)">Deactivated Only</option>
                </select>
            </div>
            <div class="col-md-2 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary-library w-100">Filter</button>
                @if (!string.IsNullOrEmpty(searchTerm) || isActive.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Librarians Table -->
<div class="card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Librarian</th>
                    <th>Contact Info</th>
                    <th>Circulation Activity</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var librarian in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3" style="width: 40px; height: 40px; background-color: #e0f2fe; color: #0284c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                        @librarian.FullName[0].ToString().ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold">@librarian.FullName</div>
                                        <div class="text-muted small">@librarian.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>@(librarian.PhoneNumber ?? "No phone recorded")</div>
                            </td>
                            <td>
                                <div class="small">
                                    <span class="badge bg-light text-dark border me-1">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> Issued: @librarian.IssuedLoansCount
                                    </span>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-box-arrow-in-down me-1"></i> Received: @librarian.ReceivedLoansCount
                                    </span>
                                </div>
                            </td>
                            <td class="small text-muted">
                                @librarian.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                @if (librarian.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-circle me-1"></i> Deactivated
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li>
                                            <a asp-action="Edit" asp-route-id="@librarian.Id" class="dropdown-item">
                                                <i class="bi bi-pencil me-2 text-primary"></i> Edit Profile
                                            </a>
                                        </li>
                                        <li>
                                            <form asp-action="ResetPassword" asp-route-id="@librarian.Id" method="post" onsubmit="return confirm('Generate a new secure temporary password for @librarian.FullName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi bi-key me-2 text-warning"></i> Reset Password
                                                </button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="ToggleStatus" asp-route-id="@librarian.Id" method="post" onsubmit="return confirm('Are you sure you want to @(librarian.IsActive ? "deactivate" : "activate") @librarian.FullName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item @(librarian.IsActive ? "text-danger" : "text-success")">
                                                    <i class="bi @(librarian.IsActive ? "bi-person-x" : "bi-person-check") me-2"></i>
                                                    @(librarian.IsActive ? "Deactivate Account" : "Activate Account")
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-6 d-block mb-2 text-secondary"></i>
                            No librarian accounts found matching your query.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
