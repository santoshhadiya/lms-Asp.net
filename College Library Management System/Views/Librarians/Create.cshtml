@model College_Library_Management_System.ViewModels.Librarians.LibrarianFormViewModel
@{
    ViewData["Title"] = "Register Librarian";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card-custom">
            <div class="card-header">
                <span class="card-title">
                    <i class="bi bi-person-plus-fill text-primary"></i> Register New Librarian
                </span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Ramesh Chandra" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="r.chandra@collegelibrary.edu" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text small">This email will serve as the librarian's login username.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+91 9876543210" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TemporaryPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="TemporaryPassword" id="libTempPassword" class="form-control" placeholder="Leave blank to auto-generate" />
                                <button type="button" class="btn btn-outline-secondary" onclick="generateLibrarianPassword()">
                                    <i class="bi bi-magic me-1"></i> Auto
                                </button>
                            </div>
                            <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
                            <div class="form-text small">Optional. If empty, a secure password is generated automatically.</div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">Account Active (Librarian can immediately log in)</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary-library">
                            <i class="bi bi-save me-1"></i> Register Librarian
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function generateLibrarianPassword() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$%';
            let pwd = 'Lib@@';
            for (let i = 0; i < 6; i++) {
                pwd += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            pwd += '9';
            document.getElementById('libTempPassword').value = pwd;
        }
    </script>
}
