@using College_Library_Management_System.Models.Enums
@model College_Library_Management_System.ViewModels.Reports.CollectionReportFilterViewModel
@{
    ViewData["Title"] = "Financial Collections & Receipts Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 d-print-none">
    <div>
        <h2 class="h4 fw-bold mb-1 text-success">Financial Collections & Receipts Report</h2>
        <p class="text-muted small mb-0">Official audit ledger of all offline fine payments collected by library staff.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
        <a asp-action="ExportCollectionsPdf"
           asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
           asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
           asp-route-paymentMethod="@Model.PaymentMethod"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
    </div>
</div>

<!-- Filters Card -->
<div class="card-custom mb-3 d-print-none">
    <div class="card-body p-3">
        <form method="get" asp-action="Collections" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">From Date</label>
                <input type="date" name="StartDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">To Date</label>
                <input type="date" name="EndDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Payment Method</label>
                <select name="PaymentMethod" class="form-select">
                    <option value="">All Payment Methods</option>
                    @foreach (var method in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@method" selected="@(Model.PaymentMethod == method ? "selected" : null)">@method</option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-success flex-grow-1">
                    <i class="bi bi-funnel"></i> Apply
                </button>
                <a asp-action="Collections" class="btn btn-light border" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Financial Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="p-3 bg-success-subtle rounded border border-success d-flex justify-content-between align-items-center">
            <div>
                <span class="text-success small fw-semibold text-uppercase d-block">Total Revenue Collected</span>
                <span class="fs-4 fw-bold text-success font-monospace">₹@Model.TotalCollected.ToString("N2")</span>
            </div>
            <i class="bi bi-cash-stack fs-1 text-success opacity-50"></i>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="p-3 bg-light rounded border d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted small fw-semibold text-uppercase d-block">Settled Receipts</span>
                <span class="fs-4 fw-bold text-dark font-monospace">@Model.TransactionsCount Transactions</span>
            </div>
            <i class="bi bi-receipt fs-1 text-muted opacity-50"></i>
        </div>
    </div>
</div>

<!-- Transactions Table -->
<div class="card-custom">
    <div class="card-header">
        <span class="card-title text-success"><i class="bi bi-journal-check"></i> Payment Collections Ledger</span>
        <span class="badge bg-secondary font-monospace">@Model.Transactions.Count records</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Receipt No.</th>
                    <th>Date (IST)</th>
                    <th>Student Details</th>
                    <th>Dept</th>
                    <th>Book / Accession</th>
                    <th>Method</th>
                    <th>Amount Paid</th>
                    <th>Cashier</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Transactions.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-cash-coin fs-2 d-block mb-2 text-secondary"></i>
                            No collection transactions found for the specified period.
                        </td>
                    </tr>
                }
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>
                            <a asp-controller="Fines" asp-action="Receipt" asp-route-receiptNumber="@t.ReceiptNumber" class="font-monospace fw-bold text-primary text-decoration-none">
                                <i class="bi bi-file-earmark-text me-1"></i>@t.ReceiptNumber
                            </a>
                        </td>
                        <td class="small">@t.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>
                            <div class="fw-semibold">@t.StudentName</div>
                            <span class="font-monospace small text-muted">@t.EnrollmentNumber</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@t.DepartmentCode</span>
                        </td>
                        <td>
                            <div class="fw-semibold text-truncate" style="max-width: 200px;" title="@t.BookTitle">@t.BookTitle</div>
                            <span class="font-monospace small text-muted">@t.AccessionNumber</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary font-monospace small">@t.PaymentMethod</span>
                        </td>
                        <td class="fw-bold font-monospace text-success fs-6">
                            ₹@t.Amount.ToString("N2")
                        </td>
                        <td class="small text-muted">@t.CashierName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
