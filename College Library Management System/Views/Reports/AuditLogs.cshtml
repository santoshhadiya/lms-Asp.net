@model College_Library_Management_System.ViewModels.Reports.AuditLogReportFilterViewModel
@{
    ViewData["Title"] = "System Security & Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">System Security & Audit Trail</h2>
        <p class="text-muted small mb-0">Immutable compliance log of all critical transactions, modifications, and administrative actions.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="AuditLogs" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Search Details</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Action, Entity, Email, Details..." value="@Model.SearchTerm" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Action</label>
                <input type="text" name="Action" class="form-control" placeholder="e.g. Issue, Return, Fine..." value="@Model.Action" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Entity Type</label>
                <input type="text" name="EntityType" class="form-control" placeholder="e.g. Loan, Fine, Book..." value="@Model.EntityType" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">From Date</label>
                <input type="date" name="StartDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-library flex-grow-1">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="AuditLogs" class="btn btn-light border" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table -->
<div class="card-custom">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-shield-check"></i> Audit Activity Logs</span>
        <span class="badge bg-secondary font-monospace">
            Total: @(Model.Logs?.TotalCount ?? 0) events
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Timestamp (IST)</th>
                    <th>Action</th>
                    <th>Target Entity</th>
                    <th>Executed By</th>
                    <th>Audit Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs == null || !Model.Logs.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-slash fs-2 d-block mb-2 text-secondary"></i>
                            No audit log entries matching the selected criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="small font-monospace" style="white-space: nowrap;">
                                @log.Timestamp.ToString("dd MMM yyyy, hh:mm:ss tt")
                            </td>
                            <td>
                                @switch (log.Action.ToLower())
                                {
                                    case "issue":
                                        <span class="badge bg-primary">Issue</span>
                                        break;
                                    case "return":
                                        <span class="badge bg-success">Return</span>
                                        break;
                                    case "renew":
                                        <span class="badge bg-info text-dark">Renew</span>
                                        break;
                                    case "finepayment":
                                        <span class="badge bg-warning text-dark">Payment</span>
                                        break;
                                    case "finewaive":
                                        <span class="badge bg-secondary">Waive</span>
                                        break;
                                    case "delete":
                                        <span class="badge bg-danger">Delete</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">@log.Action</span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="fw-semibold">@log.EntityType</span>
                                <span class="badge bg-light text-dark border small ms-1 font-monospace">#@log.EntityId</span>
                            </td>
                            <td class="small">
                                <span class="fw-semibold text-dark">@(log.PerformedByUserEmail ?? log.PerformedByUserId)</span>
                            </td>
                            <td class="small text-secondary">
                                @log.Details
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Logs != null && Model.Logs.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Showing page <strong>@Model.Logs.PageIndex</strong> of <strong>@Model.Logs.TotalPages</strong> (@Model.Logs.TotalCount total log entries)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Logs.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="AuditLogs"
                       asp-route-pageNumber="@(Model.Logs.PageIndex - 1)"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-action="@Model.Action"
                       asp-route-entityType="@Model.EntityType">Previous</a>
                </li>
                @for (int p = 1; p <= Model.Logs.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Logs.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="AuditLogs"
                           asp-route-pageNumber="@p"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-action="@Model.Action"
                           asp-route-entityType="@Model.EntityType">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Logs.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="AuditLogs"
                       asp-route-pageNumber="@(Model.Logs.PageIndex + 1)"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-action="@Model.Action"
                       asp-route-entityType="@Model.EntityType">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
