@model College_Library_Management_System.ViewModels.Reports.InventoryReportViewModel
@{
    ViewData["Title"] = "Library Inventory & Asset Status Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 d-print-none">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Inventory & Asset Status Report</h2>
        <p class="text-muted small mb-0">Detailed breakdown of library collection, physical conditions, and departmental usage.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
        <button type="button" class="btn btn-primary-library" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / Export PDF
        </button>
    </div>
</div>

<!-- Physical Status Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4 col-md-2">
        <div class="p-3 bg-light rounded border text-center">
            <span class="text-muted small text-uppercase d-block fw-semibold">Catalog Titles</span>
            <span class="fs-4 fw-bold text-dark font-monospace">@Model.TotalCatalogTitles</span>
        </div>
    </div>
    <div class="col-sm-4 col-md-2">
        <div class="p-3 bg-light rounded border text-center">
            <span class="text-muted small text-uppercase d-block fw-semibold">Total Copies</span>
            <span class="fs-4 fw-bold text-primary font-monospace">@Model.TotalPhysicalCopies</span>
        </div>
    </div>
    <div class="col-sm-4 col-md-2">
        <div class="p-3 bg-success-subtle rounded border border-success text-center">
            <span class="text-success small text-uppercase d-block fw-semibold">Available</span>
            <span class="fs-4 fw-bold text-success font-monospace">@Model.AvailableCount</span>
        </div>
    </div>
    <div class="col-sm-4 col-md-2">
        <div class="p-3 bg-info-subtle rounded border border-info text-center">
            <span class="text-info small text-uppercase d-block fw-semibold">Issued</span>
            <span class="fs-4 fw-bold text-primary font-monospace">@Model.IssuedCount</span>
        </div>
    </div>
    <div class="col-sm-4 col-md-2">
        <div class="p-3 bg-warning-subtle rounded border border-warning text-center">
            <span class="text-warning-emphasis small text-uppercase d-block fw-semibold">Damaged</span>
            <span class="fs-4 fw-bold text-warning-emphasis font-monospace">@Model.DamagedCount</span>
        </div>
    </div>
    <div class="col-sm-4 col-md-2">
        <div class="p-3 bg-danger-subtle rounded border border-danger text-center">
            <span class="text-danger small text-uppercase d-block fw-semibold">Lost / Withdrawn</span>
            <span class="fs-4 fw-bold text-danger font-monospace">@(Model.LostCount + Model.WithdrawnCount)</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Category Breakdown Table -->
    <div class="col-lg-7">
        <div class="card-custom h-100">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-tags-fill"></i> Subject Category Inventory</span>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th class="text-center">Titles</th>
                            <th class="text-center">Total Copies</th>
                            <th class="text-center">Available</th>
                            <th class="text-center">Issued</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.CategoryBreakdown)
                        {
                            <tr>
                                <td class="fw-semibold">@cat.CategoryName</td>
                                <td class="text-center font-monospace">@cat.BookCount</td>
                                <td class="text-center font-monospace fw-bold">@cat.CopyCount</td>
                                <td class="text-center">
                                    <span class="badge bg-success font-monospace">@cat.AvailableCopies</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info font-monospace text-dark">@cat.IssuedCopies</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Department Engagement Table -->
    <div class="col-lg-5">
        <div class="card-custom h-100">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-building"></i> Department Usage</span>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th class="text-center">Students</th>
                            <th class="text-center">Active Loans</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in Model.DepartmentBreakdown)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@dept.DepartmentName</div>
                                    <span class="badge bg-light text-dark border">@dept.DepartmentCode</span>
                                </td>
                                <td class="text-center font-monospace">@dept.StudentCount</td>
                                <td class="text-center">
                                    <span class="badge bg-primary font-monospace">@dept.ActiveLoansCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
