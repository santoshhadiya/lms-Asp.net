@model IEnumerable<College_Library_Management_System.ViewModels.MasterData.PublisherViewModel>
@{
    ViewData["Title"] = "Publishers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Book Publishers</h2>
        <p class="text-muted small mb-0">Publishing houses and academic presses.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-library">
        <i class="bi bi-printer me-1"></i> Add Publisher
    </a>
</div>

<div class="card-custom">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-printer-fill"></i> Registered Publishers</span>
        <span class="badge bg-secondary">Total: @Model.Count()</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Publisher Name</th>
                    <th>Location / Address</th>
                    <th>Contact Email</th>
                    <th>Books</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No publishers registered yet.</td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold">@p.Name</td>
                        <td class="text-muted small">@(p.Address ?? "N/A")</td>
                        <td class="small">@(p.ContactEmail ?? "N/A")</td>
                        <td>
                            <span class="badge rounded-pill @(p.BookCount > 0 ? "bg-info text-dark" : "bg-light text-muted border")">
                                <i class="bi bi-book me-1"></i>@p.BookCount Books
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.PublisherId" class="btn btn-outline-primary btn-sm-action me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                @if (p.BookCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@p.PublisherId" method="post" class="d-inline" onsubmit="return confirm('Delete publisher \'@p.Name\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm-action">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm-action disabled" disabled title="Cannot delete publisher with cataloged books">
                                        <i class="bi bi-lock"></i> Protected
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
