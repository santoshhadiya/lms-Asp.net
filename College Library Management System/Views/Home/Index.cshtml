@model College_Library_Management_System.ViewModels.Reports.DashboardViewModel
@{
    ViewData["Title"] = "Library Operations Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Library Operations Center</h2>
        <p class="text-muted small mb-0">Real-time overview of catalog inventory, active circulations, and financial balances.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Circulation" asp-action="Issue" class="btn btn-primary-library">
            <i class="bi bi-box-arrow-up-right me-1"></i> Issue Book
        </a>
        <a asp-controller="Circulation" asp-action="Return" class="btn btn-outline-success">
            <i class="bi bi-box-arrow-in-down me-1"></i> Quick Return
        </a>
    </div>
</div>

<!-- Primary Stats Row -->
<div class="row g-3 mb-4">
    <!-- Catalog Titles -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-journal-bookmark-fill"></i>
            </div>
            <div>
                <span class="stat-label">Catalog Titles</span>
                <div class="stat-value">@Model.TotalBooks</div>
                <div class="small text-muted mt-1">@Model.TotalCopies total physical copies</div>
            </div>
        </div>
    </div>

    <!-- Active Loans -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-info-subtle text-info">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div>
                <span class="stat-label">Active Loans</span>
                <div class="stat-value text-primary">@Model.ActiveLoans</div>
                <div class="small text-muted mt-1">@Model.AvailableCopies copies available on shelf</div>
            </div>
        </div>
    </div>

    <!-- Overdue Loans Alert -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card @(Model.OverdueLoans > 0 ? "border-danger border-2" : "")">
            <div class="stat-icon @(Model.OverdueLoans > 0 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">
                <i class="bi @(Model.OverdueLoans > 0 ? "bi-exclamation-octagon-fill" : "bi-check2-circle")"></i>
            </div>
            <div>
                <span class="stat-label">Overdue Loans</span>
                <div class="stat-value @(Model.OverdueLoans > 0 ? "text-danger" : "text-success")">@Model.OverdueLoans</div>
                <div class="small text-muted mt-1">
                    @(Model.OverdueLoans > 0 ? "Action required: contact students" : "All books on schedule")
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Collections / Pending -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-warning-subtle text-dark">
                <i class="bi bi-currency-rupee"></i>
            </div>
            <div>
                <span class="stat-label">Outstanding Fines</span>
                <div class="stat-value text-danger">₹@Model.TotalPendingFines.ToString("N2")</div>
                <div class="small text-success mt-1">
                    <i class="bi bi-check-circle me-1"></i>₹@Model.TotalFinesCollected.ToString("N2") collected
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Stats & Quick Navigation Row -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card-custom h-100">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-lightning-charge-fill text-warning"></i> Operational Quick Actions</span>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-sm-6 col-md-3">
                        <a asp-controller="Circulation" asp-action="Issue" class="btn btn-light border w-100 p-3 text-start d-flex flex-column gap-1 h-100">
                            <i class="bi bi-box-arrow-up-right fs-4 text-primary"></i>
                            <span class="fw-bold small text-dark">Issue Book</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Issue to verified student</span>
                        </a>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <a asp-controller="Circulation" asp-action="Return" class="btn btn-light border w-100 p-3 text-start d-flex flex-column gap-1 h-100">
                            <i class="bi bi-box-arrow-in-down fs-4 text-success"></i>
                            <span class="fw-bold small text-dark">Return Book</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Scan copy accession no.</span>
                        </a>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <a asp-controller="Fines" asp-action="Index" class="btn btn-light border w-100 p-3 text-start d-flex flex-column gap-1 h-100">
                            <i class="bi bi-currency-rupee fs-4 text-danger"></i>
                            <span class="fw-bold small text-dark">Collect Fines</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Offline full settlement</span>
                        </a>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <a asp-controller="Books" asp-action="Create" class="btn btn-light border w-100 p-3 text-start d-flex flex-column gap-1 h-100">
                            <i class="bi bi-journal-plus fs-4 text-info"></i>
                            <span class="fw-bold small text-dark">Add New Book</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Add title to catalog</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-custom h-100">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-pie-chart-fill text-primary"></i> Inventory Overview</span>
                <a asp-controller="BookCopies" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="card-body p-3">
                <div class="d-flex justify-content-between py-2 border-bottom small">
                    <span class="text-muted"><i class="bi bi-circle-fill text-success me-2" style="font-size: 0.6rem;"></i> Available on Stacks</span>
                    <strong class="font-monospace">@Model.AvailableCopies</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom small">
                    <span class="text-muted"><i class="bi bi-circle-fill text-info me-2" style="font-size: 0.6rem;"></i> Issued to Students</span>
                    <strong class="font-monospace">@Model.IssuedCopies</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom small">
                    <span class="text-muted"><i class="bi bi-circle-fill text-warning me-2" style="font-size: 0.6rem;"></i> Damaged / In Repair</span>
                    <strong class="font-monospace">@Model.DamagedCopies</strong>
                </div>
                <div class="d-flex justify-content-between py-2 small">
                    <span class="text-muted"><i class="bi bi-people-fill text-primary me-2"></i> Registered Students</span>
                    <strong class="font-monospace">@Model.TotalStudents</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Overdue Alerts Section -->
@if (Model.OverdueAlerts.Any())
{
    <div class="card-custom mb-4 border-danger">
        <div class="card-header bg-danger-subtle">
            <span class="card-title text-danger">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Urgent: Overdue Circulation Alerts
            </span>
            <a asp-controller="Reports" asp-action="Overdue" class="btn btn-sm btn-outline-danger">
                Complete Overdue Report &rarr;
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Dept</th>
                        <th>Book / Accession</th>
                        <th>Due Date</th>
                        <th>Overdue Days</th>
                        <th>Late Fee</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.OverdueAlerts)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@alert.StudentName</div>
                                <span class="font-monospace small text-muted">@alert.StudentEnrollment</span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@alert.DepartmentCode</span></td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width: 220px;">@alert.BookTitle</div>
                                <span class="font-monospace small text-muted">@alert.AccessionNumber</span>
                            </td>
                            <td class="text-danger fw-bold small">@alert.DueAt.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-danger">@alert.OverdueDays days</span></td>
                            <td class="fw-bold font-monospace text-danger">₹@alert.EstimatedFine.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-controller="Circulation" asp-action="Return" asp-route-id="@alert.LoanId" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-box-arrow-in-down me-1"></i> Return
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Circulations & Collections Row -->
<div class="row g-4">
    <!-- Recent Active Loans -->
    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-clock-history"></i> Recent Book Loans</span>
                <a asp-controller="Circulation" asp-action="ActiveLoans" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Student</th>
                            <th>Due Date</th>
                            <th class="text-end">Staff</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentLoans.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">No active loans found.</td>
                            </tr>
                        }
                        @foreach (var loan in Model.RecentLoans)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-truncate" style="max-width: 180px;" title="@loan.BookTitle">@loan.BookTitle</div>
                                    <span class="font-monospace small text-muted">@loan.AccessionNumber</span>
                                </td>
                                <td>
                                    <div class="small fw-semibold">@loan.StudentName</div>
                                    <span class="font-monospace small text-muted" style="font-size: 0.75rem;">@loan.StudentEnrollment</span>
                                </td>
                                <td class="small">@loan.DueAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end small text-muted">@loan.IssuedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Collections -->
    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-receipt"></i> Recent Fine Payments</span>
                <a asp-controller="Fines" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Receipt</th>
                            <th>Student</th>
                            <th>Amount</th>
                            <th class="text-end">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentPayments.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">No payment transactions recorded yet.</td>
                            </tr>
                        }
                        @foreach (var p in Model.RecentPayments)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Fines" asp-action="Receipt" asp-route-receiptNumber="@p.ReceiptNumber" class="font-monospace fw-bold small text-decoration-none text-primary">
                                        @p.ReceiptNumber
                                    </a>
                                </td>
                                <td>
                                    <div class="small fw-semibold">@p.StudentName</div>
                                    <span class="font-monospace small text-muted" style="font-size: 0.75rem;">@p.StudentEnrollment</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success font-monospace small">₹@p.AmountPaid.ToString("N2")</span>
                                </td>
                                <td class="text-end small text-muted">
                                    @(p.PaymentDate?.ToString("dd MMM yyyy") ?? "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
