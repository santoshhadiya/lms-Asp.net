@model College_Library_Management_System.ViewModels.StudentDashboard.StudentDashboardViewModel
@{
    ViewData["Title"] = "My Issued Books & Loan History";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">
            <i class="bi bi-book-half me-1"></i> My Issued Books & Borrowing History
        </h2>
        <div class="text-muted small">Overview of all active loans, due dates, and past returned items.</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<!-- Active Books Section -->
<div class="card-custom mb-4">
    <div class="card-header">
        <span class="card-title text-primary">
            <i class="bi bi-clock-history me-1"></i> Currently Borrowed Books (@Model.ActiveLoans.Count / @Model.MaxBorrowingLimit max)
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Book Title</th>
                    <th>Accession No.</th>
                    <th>Issued Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ActiveLoans.Any())
                {
                    foreach (var loan in Model.ActiveLoans)
                    {
                        <tr class="@(loan.IsOverdue ? "table-danger" : "")">
                            <td>
                                <div class="fw-bold">@loan.BookTitle</div>
                                @if (loan.RenewalCount > 0)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.75rem;">Renewed 1 time</span>
                                }
                            </td>
                            <td><code class="text-primary fw-semibold">@loan.AccessionNumber</code></td>
                            <td>@loan.IssuedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                <div class="fw-bold @(loan.IsOverdue ? "text-danger" : "text-dark")">
                                    @loan.DueAt.ToString("dd MMM yyyy")
                                </div>
                            </td>
                            <td>
                                @if (loan.IsOverdue)
                                {
                                    <span class="badge bg-danger p-2">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Overdue (@loan.DaysOverdue days) - Est. Fine: ₹@loan.EstimatedFine.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle p-2">
                                        <i class="bi bi-check-circle me-1"></i> Due in @((loan.DueAt.Date - DateTime.Now.Date).Days) days
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-journal-check fs-2 d-block mb-1 text-success"></i>
                            You have no currently active book loans.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Past Borrowing History Section -->
<div class="card-custom">
    <div class="card-header">
        <span class="card-title text-secondary">
            <i class="bi bi-archive-fill me-1"></i> Complete Borrowing History (@Model.BorrowingHistory.Count items)
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Book Title</th>
                    <th>Accession No.</th>
                    <th>Issued Date</th>
                    <th>Due Date</th>
                    <th>Returned Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.BorrowingHistory.Any())
                {
                    foreach (var loan in Model.BorrowingHistory)
                    {
                        <tr>
                            <td class="fw-semibold">@loan.BookTitle</td>
                            <td><code>@loan.AccessionNumber</code></td>
                            <td class="small text-muted">@loan.IssuedAt.ToString("dd MMM yyyy")</td>
                            <td class="small text-muted">@loan.DueAt.ToString("dd MMM yyyy")</td>
                            <td class="small text-success fw-semibold">
                                @(loan.ReturnedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-check2 me-1"></i> Returned
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No past borrowing records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
