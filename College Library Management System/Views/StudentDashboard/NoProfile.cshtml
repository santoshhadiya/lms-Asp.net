@{
    ViewData["Title"] = "Student Profile Not Found";
}

<div class="card-custom text-center py-5">
    <div class="card-body">
        <div class="mb-3 text-warning">
            <i class="bi bi-person-exclamation display-1"></i>
        </div>
        <h3 class="fw-bold text-dark">Student Record Not Linked</h3>
        <p class="text-muted col-md-6 mx-auto mb-4">
            Your login account is active, but your student enrollment record has not been linked yet. Please visit the library circulation desk with your college ID card to complete your enrollment linkage.
        </p>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
            </button>
        </form>
    </div>
</div>
