@model IEnumerable<College_Library_Management_System.ViewModels.MasterData.CategoryViewModel>
@{
    ViewData["Title"] = "Book Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Book Categories</h2>
        <p class="text-muted small mb-0">Classify library books by subject and academic discipline.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-library">
        <i class="bi bi-tag me-1"></i> Add Category
    </a>
</div>

<div class="card-custom">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-tags-fill"></i> Categories</span>
        <span class="badge bg-secondary">Total: @Model.Count()</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Cataloged Books</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No categories created yet.</td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold">@c.Name</td>
                        <td class="text-muted small">@(c.Description ?? "No description")</td>
                        <td>
                            <span class="badge rounded-pill @(c.BookCount > 0 ? "bg-info text-dark" : "bg-light text-muted border")">
                                <i class="bi bi-book me-1"></i>@c.BookCount Books
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-outline-primary btn-sm-action me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                @if (c.BookCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Delete category \'@c.Name\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm-action">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm-action disabled" disabled title="Cannot delete category with cataloged books">
                                        <i class="bi bi-lock"></i> Protected
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
