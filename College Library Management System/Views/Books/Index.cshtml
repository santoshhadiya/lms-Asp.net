@using College_Library_Management_System.ViewModels.Books
@model College_Library_Management_System.ViewModels.Common.PaginatedList<BookListItemViewModel>
@{
    ViewData["Title"] = "Book Catalog";
    var filter = (BookListFilterViewModel)ViewBag.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1 text-primary">Library Book Catalog</h2>
        <p class="text-muted small mb-0">Search, browse, and manage college library book titles and copy availability.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-library">
        <i class="bi bi-journal-plus me-1"></i> Add Book to Catalog
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted">Search Catalog</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Title, Author, ISBN, Accession No..." value="@filter.SearchTerm" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Category</label>
                <select name="CategoryId" class="form-select" asp-items="filter.CategoryOptions">
                    <option value="">-- All Categories --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Publisher</label>
                <select name="PublisherId" class="form-select" asp-items="filter.PublisherOptions">
                    <option value="">-- All Publishers --</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary-library flex-grow-1">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-light border" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Books Catalog Table -->
<div class="card-custom">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-journal-bookmark-fill"></i> Books in Catalog</span>
        <span class="badge bg-secondary">Total: @Model.TotalCount titles</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle">
            <thead>
                <tr>
                    <th>Title & ISBN</th>
                    <th>Authors</th>
                    <th>Category</th>
                    <th>Publisher</th>
                    <th>Year</th>
                    <th>Inventory Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-3 d-block mb-2"></i>
                            No books found matching the selected search criteria.
                        </td>
                    </tr>
                }
                @foreach (var book in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@book.BookId" class="fw-bold text-primary text-decoration-none d-block">
                                @book.Title
                            </a>
                            <span class="font-monospace small text-muted">
                                ISBN: @(string.IsNullOrEmpty(book.ISBN) ? "N/A" : book.ISBN)
                            </span>
                        </td>
                        <td>
                            <span class="small text-secondary">
                                @(string.IsNullOrEmpty(book.AuthorsString) ? "Unassigned" : book.AuthorsString)
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@book.CategoryName</span>
                        </td>
                        <td class="small text-muted">@book.PublisherName</td>
                        <td>@(book.PublicationYear?.ToString() ?? "-")</td>
                        <td>
                            <div>
                                <span class="badge-status badge-available">
                                    <i class="bi bi-check-circle"></i> @book.AvailableCopiesCount Available
                                </span>
                            </div>
                            <div class="small text-muted mt-1">
                                Total: @book.TotalCopiesCount copies (@book.IssuedCopiesCount issued)
                            </div>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-info btn-sm-action me-1" title="View Details and Copies">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-outline-primary btn-sm-action me-1" title="Edit Catalog Entry">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            @if (User.IsInRole("Admin") && book.TotalCopiesCount == 0)
                            {
                                <form asp-action="Delete" asp-route-id="@book.BookId" method="post" class="d-inline" onsubmit="return confirm('Delete book \'@book.Title\' from catalog?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm-action" title="Delete Book">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <div class="small text-muted">
                Showing page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount total books)
            </div>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-PageNumber="@(Model.PageIndex - 1)"
                       asp-route-SearchTerm="@filter.SearchTerm"
                       asp-route-CategoryId="@filter.CategoryId"
                       asp-route-PublisherId="@filter.PublisherId">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-PageNumber="@i"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-CategoryId="@filter.CategoryId"
                           asp-route-PublisherId="@filter.PublisherId">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-PageNumber="@(Model.PageIndex + 1)"
                       asp-route-SearchTerm="@filter.SearchTerm"
                       asp-route-CategoryId="@filter.CategoryId"
                       asp-route-PublisherId="@filter.PublisherId">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
